NODE_ENV=development
# Global directory + one operational database/building per institution.
# Dedicated sample workspace is never seeded at startup. Explicit setup only:
ENABLE_DEMO_SETUP=false
ALLOW_PRODUCTION_DEMO_SEED=false
# Only explicit npm run seed reads these credentials. Startup/login ignore them.
# Local test/development seed: minimum 6 characters; production seed: minimum 20.
# Populate through npm run setup -- --enable-demo (local), or server secrets.
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
# DEMO_VIEWER_EMAIL=
# DEMO_VIEWER_PASSWORD=
PORT=5000
HOST=127.0.0.1
APP_TIMEZONE=Asia/Kolkata
MONGODB_URI=mongodb://127.0.0.1:27017/campus_energy
# Editing this file requires restarting API/worker; an explicitly set process variable takes precedence.
SESSION_SECRET=replace_with_generated_secret
SERVICE_INGEST_TOKEN=replace_with_separate_generated_secret
DEMO_PASSWORD=replace_with_local_demo_password
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5000
DEMO_MODE=true
ALLOW_PHYSICAL_CONTROL=false
DEVICE_ADAPTER=simulator

# Optional native OFF for existing equipment through an explicitly reviewed HA gateway.
# This separate gate never enables physical room-master switching.
ALLOW_NATIVE_DEVICE_CONTROL=false
HA_ALLOWED_ORIGINS=
HA_ALLOW_HTTP=false
HA_ALLOW_LOOPBACK=false
DEMO_TIME_SCALE=60
NOTIFICATIONS_MODE=in_app
VACANCY_CONFIRMATION_MINUTES=15
FIRST_ESCALATION_MINUTES=10
FINAL_ESCALATION_ADDITIONAL_MINUTES=15
BOOKING_PREPARATION_MINUTES=15
QR_MAX_DURATION_MINUTES=120
QR_EXPIRY_WARNING_MINUTES=10
VISION_BASE_URL=http://127.0.0.1:8001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEMO_VISION_PYTHON=python
# Exact optional standalone phone-development origins; same-origin HTTPS is preferred.
DEMO_PHONE_ORIGINS=http://localhost:5174,http://localhost:5175
# Optional complete standalone app URLs, trailing / required; origin must be allowed above.
# DEMO_CAMERA_APP_URL=https://camera.example.org/
# DEMO_CLASSROOM_APP_URL=https://classroom.example.org/
# Browser builds read public origins from their build environment, not this server file:
# Vercel main: leave VITE_API_ORIGIN blank and use generated /api + /assistant proxy.
# VITE_API_ORIGIN=
# VITE_REALTIME_ORIGIN=https://energy.example.org
# PHONE_API_ORIGIN=https://energy.example.org
# PHONE_REALTIME_ORIGIN=https://energy.example.org

# Optional local meter OCR; run npm run setup:ocr explicitly. No camera URLs.
OCR_PYTHON=python
# OCR_MODULE_PATH=absolute/path/to/ocr-python
# OCR_TESSDATA_PATH=absolute/path/to/tessdata

# Building Join Codes belong only in the write-only administrator setting, never here.
# Keep SESSION_SECRET stable; changing it requires replacing Building Join Codes.

# Server-only key required only to create a new Administrator account.
# Blank disables Administrator registration, not existing-user sign-in.
ADMIN_INVITE_KEY=

# Optional durable assistant storage directory (Render disk; never a public URL).
# ASSISTANT_DATA_DIR=/app/.local/assistant
# Production ignores local .env; set required configuration on the host.
