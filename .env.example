NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Kolkata
MONGODB_URI=mongodb://127.0.0.1:27017/campus_energy
SESSION_SECRET=replace_with_generated_secret
SERVICE_INGEST_TOKEN=replace_with_separate_generated_secret
