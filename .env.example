NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Kolkata
MONGODB_URI=mongodb://127.0.0.1:27017/campus_energy
# Eight-digit admin key; generated by npm run setup (or --generate-admin-key to rotate).
# Server-only; exactly eight generated digits. Blank disables admin enrollment/activation, not existing-user login.
# Editing this file requires restarting API/worker; an explicitly set process variable takes precedence.
# npm run setup generates this for new installations. Never put it in a VITE variable.
ADMIN_INVITE_KEY=replace_with_generated_eight_digit_key
SESSION_SECRET=replace_with_generated_secret
SERVICE_INGEST_TOKEN=replace_with_separate_generated_secret
DEMO_PASSWORD=replace_with_local_demo_password
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5000
DEMO_MODE=true
ALLOW_PHYSICAL_CONTROL=false
DEVICE_ADAPTER=simulator

# Optional native OFF for existing equipment through an explicitly reviewed HA gateway.
# This separate gate never enables physical room-master switching.
ALLOW_NATIVE_DEVICE_CONTROL=false
HA_ALLOWED_ORIGINS=
HA_ALLOW_HTTP=false
HA_ALLOW_LOOPBACK=false
DEMO_TIME_SCALE=60
NOTIFICATIONS_MODE=in_app
VACANCY_CONFIRMATION_MINUTES=15
FIRST_ESCALATION_MINUTES=10
FINAL_ESCALATION_ADDITIONAL_MINUTES=15
BOOKING_PREPARATION_MINUTES=15
QR_MAX_DURATION_MINUTES=120
QR_EXPIRY_WARNING_MINUTES=10
VISION_BASE_URL=http://127.0.0.1:8001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEMO_VISION_PYTHON=python
# Exact optional standalone phone-development origins; same-origin HTTPS is preferred.
DEMO_PHONE_ORIGINS=http://localhost:5174,http://localhost:5175
