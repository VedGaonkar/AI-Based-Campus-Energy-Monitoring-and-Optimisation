# Server-only deployment file. Copy to deployment/.env (ignored), restrict permissions.
# Supply actual DNS hostname without scheme/path. No real values in this example.
APP_HOST=energy.example.org
MONGO_USERNAME=campus_operator
# Generate a unique URL-safe password; URI characters must otherwise be percent-encoded.
MONGO_PASSWORD=replace_with_unique_url_safe_password
SESSION_SECRET=replace_with_unique_random_64_character_secret
SERVICE_INGEST_TOKEN=replace_with_separate_random_64_character_secret
ADMIN_INVITE_KEY=replace_with_private_administrator_registration_key
# Production policy timing; explicit presenter sessions still remain simulated.
DEMO_MODE=false
DEMO_TIME_SCALE=1
DEVICE_ADAPTER=simulator
# Optional external model. Direct database answers work without it.
GEMINI_API_KEY=
# GEMINI_MODEL=replace_with_a_currently_available_verified_model
