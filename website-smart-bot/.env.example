# Copy to .env (this folder only) and fill in. .env is never committed.

# --- Gemini ---------------------------------------------------------------
# Server-side only. Leave blank to run with direct website answers only.
GEMINI_API_KEY=
# Configurable on purpose. Confirm the identifier exists for your key with:  npm run check:model
GEMINI_MODEL=gemini-3.8-flash

# Limits shown on your Gemini API dashboard. The assistant never exceeds them.
GEMINI_RPM=5
GEMINI_RPD=20
# Daily requests held back for administrators once viewers have used the rest.
GEMINI_ADMIN_RESERVE=8
GEMINI_VIEWER_PER_USER_DAILY=3
GEMINI_ADMIN_PER_USER_DAILY=14
GEMINI_USER_MIN_INTERVAL_SECONDS=15
# Gemini API daily quotas reset at midnight Pacific time.
GEMINI_QUOTA_RESET_TZ=America/Los_Angeles
GEMINI_MAX_RETRY_WAIT_SECONDS=20
GEMINI_CACHE_TTL_SECONDS=600
GEMINI_TIMEOUT_MS=45000
# MINIMAL is much faster than the model's default reasoning. Use DEFAULT to leave it unset.
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_MAX_OUTPUT_TOKENS=1500

# --- The website this assistant sits in front of ----------------------------
# The website's API. Every read and every change goes through it, as the signed-in person.
APP_API_URL=http://127.0.0.1:5000/api/v1
# An origin the website already trusts for cookie-authenticated writes (its FRONTEND_ORIGIN or PUBLIC_APP_URL).
APP_ORIGIN=http://localhost:5173
# Where links to rooms point (the website's own front end).
APP_PUBLIC_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# --- This service ---------------------------------------------------------
ASSISTANT_PORT=5190
# The address browsers use for the assistant. Writes are accepted only from this origin.
ASSISTANT_PUBLIC_URL=http://localhost:5190

# --- Behaviour ------------------------------------------------------------
# Website data is re-read on demand; this is how long a read may be reused. Cleared after every change made here.
DATA_CACHE_TTL_SECONDS=3
HISTORY_TURNS=6
PROPOSAL_TTL_MINUTES=10
MESSAGES_PER_MINUTE=30
CONFIRMS_PER_MINUTE=20
# SQLite file for quota counts, proposals, announcements and the audit log.
# DB_PATH=./.data/assistant.sqlite
