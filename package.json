{
  "name": "campus-energy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "db": "node scripts/database.mjs",
    "start": "node backend/src/server.js",
    "worker": "node backend/src/workers/run.js",
    "seed": "node scripts/seed-demo-workspace.mjs",
    "migrate:institutions": "node scripts/migrate-institutions.mjs",
    "build": "npm run build:main && npm run build:demo",
    "build:main": "npm run build --workspace frontend",
    "build:phone-camera": "node scripts/build-demo-apps.mjs camera",
    "build:classroom": "node scripts/build-demo-apps.mjs classroom",
    "build:demo": "node scripts/build-demo-apps.mjs all && node scripts/check-demo-apps.mjs",
    "demo:camera": "node scripts/demo-app.mjs camera",
    "demo:classroom": "node scripts/demo-app.mjs classroom",
    "test:phone-demo": "node --test --test-concurrency=1 tests/phone-demo.test.js",
    "test:phone-browser": "node scripts/phone-demo-browser.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test tests/policies.test.js tests/energy.test.js",
    "check": "node scripts/check.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:auth-browser": "node scripts/institutions-browser.mjs",
    "test:admin-browser": "node scripts/admin-browser-smoke.mjs",
    "test:devices-browser": "node scripts/connected-devices-browser.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "test:realtime-browser": "node scripts/realtime-browser.mjs",
    "test:consumption-browser": "node scripts/consumption-browser.mjs",
    "test:sustainability-browser": "node scripts/sustainability-browser.mjs",
    "test:cross-origin-browser": "node scripts/cross-origin-browser.mjs",
    "test:final-browsers": "node scripts/final-browser-checks.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "test:meter-browser": "node scripts/meter-camera-browser.mjs",
    "test:meter-camera": "node --test tests/meter-camera.test.js"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "node": "26.13.1",
    "supertest": "7.3.2"
  }
}
